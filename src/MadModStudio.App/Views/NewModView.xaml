<UserControl x:Class="MadModStudio.App.Views.NewModView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MadModStudio.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="New Mod" Style="{StaticResource H1}" />
            <views:PageStatusBar />
            <Border Style="{StaticResource Notice}">
                <TextBlock TextWrapping="Wrap" Text="{Binding AIStatusText}" />
            </Border>
            <Border Style="{StaticResource Notice}" Visibility="{Binding State.CurrentProfile, Converter={StaticResource InvNullToVis}}">
                <TextBlock TextWrapping="Wrap" Text="No Game Profile selected. Agents must verify game APIs against your installed game: add and index your 7 Days to Die installation first." />
            </Border>
            <TextBlock Text="What do you want to build?" Style="{StaticResource H2}" />
            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineBox}" Height="140" FontSize="14" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Mod name" Style="{StaticResource Label}" />
                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Width="320" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Create Project &amp; Start Agents" Style="{StaticResource AccentButton}" Command="{Binding CreateWithAgentsCommand}" IsEnabled="{Binding IsAIConfigured}" />
                <Button Content="Create Empty Project" Command="{Binding CreateEmptyCommand}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="The project opens on its Agents tab: the Lead Agent classifies and plans, specialists research the installed game and implement, then the real compiler and validator check the result and an independent Validator reviews it. You are told which provider(s) will receive data before anything is sent." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
