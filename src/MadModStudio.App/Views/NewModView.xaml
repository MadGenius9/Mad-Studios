<UserControl x:Class="MadModStudio.App.Views.NewModView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MadModStudio.App.Views">
    <Grid Margin="32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="New Mod" Style="{StaticResource H1}" />
                <views:PageStatusBar />
                <Border Style="{StaticResource Notice}" Visibility="{Binding IsAIConfigured, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock TextWrapping="Wrap" Text="AI is not configured. Add an API key in Settings to plan and generate mods with AI. You can still create an empty project and build it manually." />
                </Border>
                <Border Style="{StaticResource Notice}" Visibility="{Binding State.CurrentProfile, Converter={StaticResource InvNullToVis}}">
                    <TextBlock TextWrapping="Wrap" Text="No Game Profile selected. Plans must be grounded in your installed game: add and index your 7 Days to Die installation first." />
                </Border>
                <TextBlock Text="What do you want to build?" Style="{StaticResource H2}" />
                <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineBox}" Height="120" FontSize="14" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Classify &amp; Plan" Style="{StaticResource AccentButton}" Command="{Binding MakePlanCommand}" IsEnabled="{Binding IsAIConfigured}" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,6,0,0"
                           Text="Planning sends your request and the game API names the AI looks up to the AI provider. You will be asked to confirm first." />
                <TextBlock Text="Plan" Style="{StaticResource H2}" Margin="0,16,0,6" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mod name" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Width="280" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Create Project &amp; Generate" Style="{StaticResource AccentButton}" Command="{Binding GenerateCommand}"
                            IsEnabled="{Binding HasPlan}" />
                    <Button Content="Create Empty Project" Command="{Binding CreateEmptyCommand}" />
                </StackPanel>
            </StackPanel>
            <TextBox Text="{Binding PlanText, Mode=OneWay}" Style="{StaticResource ReadOnlyMono}" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="AI activity" Style="{StaticResource H2}" Margin="0,4,0,6" />
            <ListBox ItemsSource="{Binding Events}" FontFamily="{StaticResource MonoFont}" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
