<UserControl x:Class="MadModStudio.App.Views.AgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AgentState" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Working"><Setter Property="Foreground" Value="{StaticResource InfoBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Planning"><Setter Property="Foreground" Value="{StaticResource InfoBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Complete"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Blocked"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NeedsReview"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Waiting"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Request -->
        <StackPanel DockPanel.Dock="Top">
            <Border Style="{StaticResource Notice}">
                <TextBlock TextWrapping="Wrap" Text="{Binding AiAvailability}" />
            </Border>
            <DockPanel Margin="0,4,0,0">
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="200">
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,0,0,4" ToolTip="Repair an existing mod, create new functionality, or improve the mod." />
                    <CheckBox Content="Package when complete" IsChecked="{Binding Package}" Margin="0,2" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Run Agents" Style="{StaticResource AccentButton}" Command="{Binding RunAgentsCommand}" IsEnabled="{Binding HasModels}" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="What should the team do?" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineBox}" Height="56" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Working version…" Command="{Binding BrowseWorkingVersionCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding WorkingVersionPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional last known working version (ZIP or folder) for comparison." />
                    </DockPanel>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding RunStatus}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />

            <!-- Escalation suggestion -->
            <Border Style="{StaticResource Notice}" BorderBrush="{StaticResource WarningBrush}" Visibility="{Binding HasEscalation, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Escalation.Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Escalation.Reasons}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Dim}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding TrySuggestedCommand}">
                            <TextBlock><Run Text="TRY" /> <Run Text="{Binding Escalation.SuggestedDisplay, Mode=OneWay}" /></TextBlock>
                        </Button>
                        <Button Content="KEEP CURRENT MODEL" Command="{Binding KeepCurrentModelCommand}" />
                        <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding EscalationChoice}" Width="240" Margin="8,0,4,0" />
                        <Button Content="CHOOSE MODEL" Command="{Binding TryChosenModelCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Pending approval banner -->
            <Border Style="{StaticResource Notice}" BorderBrush="{StaticResource InfoBrush}" Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding PendingApprovals.Count, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="agent change(s) are waiting for your approval (GUIDED control). Review them on the Approvals tab." />
                </TextBlock>
            </Border>
        </StackPanel>

        <TabControl Margin="0,8,0,0">
            <!-- Agent Board -->
            <TabItem Header="Agent Board">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource AgentState}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding AgentName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="·" Foreground="{StaticResource TextDimBrush}" />
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding ModelDisplay}" Style="{StaticResource Dim}" FontSize="11" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" />
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding RetryModel}" Width="200" Margin="0,0,6,0"
                                          ToolTip="AUTO picks a model this task has not tried yet." />
                                <Button Content="Try Another Model" Command="{Binding TryAnotherModelCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Run Waiting Task" Command="{Binding RunManualTaskCommand}" ToolTip="MANUAL control: run the selected waiting task." />
                                <Button Content="Show Handoff" Command="{Binding ShowHandoffCommand}" ToolTip="Structured, provider-independent handoff for continuing with any model." />
                            </StackPanel>
                        </StackPanel>
                        <TextBox Text="{Binding TaskDetails, Mode=OneWay}" Style="{StaticResource ReadOnlyMono}" TextWrapping="Wrap"
                                 ToolTip="Agent actions, files, findings and routing reasons. Hidden model reasoning is never shown." />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Approvals -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock><Run Text="Approvals (" /><Run Text="{Binding PendingApprovals.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="A revision is created before any approved change is applied, so it can always be restored." />
                        <ListBox ItemsSource="{Binding PendingApprovals}" SelectedItem="{Binding SelectedPending}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding Agent}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Dim}" FontSize="11"><Run Text="{Binding Provider, Mode=OneWay}" /> / <Run Text="{Binding Model, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" />
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Approve Change" Style="{StaticResource AccentButton}" Command="{Binding ApproveChangeCommand}" CommandParameter="{Binding SelectedPending}" />
                            <Button Content="Reject Change" Style="{StaticResource DangerButton}" Command="{Binding RejectChangeCommand}" CommandParameter="{Binding SelectedPending}" />
                        </StackPanel>
                        <TextBox Text="{Binding SelectedPending.Diff, Mode=OneWay}" Style="{StaticResource ReadOnlyMono}" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- AI Team -->
            <TabItem Header="AI Team">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding TeamSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Routing" Style="{StaticResource Label}" Width="70" />
                            <ComboBox ItemsSource="{Binding RoutingOptions}" SelectedItem="{Binding RoutingChoice}" Width="170" Margin="0,0,16,0" />
                            <TextBlock Text="Control" Style="{StaticResource Label}" Width="60" />
                            <ComboBox ItemsSource="{Binding ControlOptions}" SelectedItem="{Binding ControlChoice}" Width="170" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="MANAGE TEAM: each agent can use AUTO (router picks per task) or a specific model. Switching models keeps all context: agents work from Mad Mod Studio's project knowledge, not a provider's chat history." />
                        <ItemsControl ItemsSource="{Binding Team}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding DisplayName}" Width="190" VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Width="280" />
                                        <Button Content="Why this model?" Padding="8,2"
                                                Command="{Binding DataContext.WhyThisModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Save Team" Style="{StaticResource AccentButton}" Command="{Binding SaveTeamCommand}" HorizontalAlignment="Left" Margin="0,8,0,8" />
                        <TextBox Text="{Binding WhyText, Mode=OneWay}" Style="{StaticResource ReadOnlyMono}" TextWrapping="Wrap" MinHeight="80" />

                        <TextBlock Text="Run a single agent" Style="{StaticResource H2}" Margin="0,16,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding AgentKinds}" SelectedItem="{Binding ManualAgent}" Width="190" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding ManualModel}" Width="240" Margin="0,0,6,0" />
                            <Button Content="Run Agent" Command="{Binding RunManualTaskCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding ManualInstructions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineBox}" Height="56" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Proposals -->
            <TabItem Header="Proposals">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding CreatedUtc, Mode=OneWay, Converter={StaticResource LocalTime}}" Width="120" />
                            <DataGridTextColumn Header="Agent" Binding="{Binding Agent, Mode=OneWay}" Width="120" />
                            <DataGridTextColumn Header="Model" Binding="{Binding Model, Mode=OneWay}" Width="*" />
                            <DataGridTextColumn Header="Change" Binding="{Binding Title, Mode=OneWay}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,6">
                        <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding RetryModel}" Width="200" Margin="0,0,6,0" />
                        <Button Content="Ask Another Model" Command="{Binding AskAnotherModelCommand}"
                                ToolTip="Gets an alternative proposal and evaluates both in a sandbox with the real compiler and validator. Evidence decides, not AI votes." />
                        <Button Content="Apply Proposal" Command="{Binding ApplySelectedProposalCommand}" />
                        <Button Content="Restore Before This Agent Change" Style="{StaticResource DangerButton}" Command="{Binding RestoreBeforeProposalCommand}" />
                    </WrapPanel>
                    <TextBox Grid.Row="2" Text="{Binding SecondOpinionText, Mode=OneWay}" Style="{StaticResource ReadOnlyMono}" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <!-- Report / activity / handoff -->
            <TabItem Header="Report">
                <TextBox Text="{Binding Report, Mode=OneWay}" Style="{StaticResource ReadOnlyMono}" TextWrapping="Wrap" />
            </TabItem>
            <TabItem Header="Activity">
                <ListBox ItemsSource="{Binding Events}" FontFamily="{StaticResource MonoFont}" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Handoff">
                <TextBox Text="{Binding HandoffText, Mode=OneWay}" Style="{StaticResource ReadOnlyMono}" TextWrapping="Wrap" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
