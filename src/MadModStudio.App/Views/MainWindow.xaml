<Window x:Class="MadModStudio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MadModStudio.App.ViewModels"
        xmlns:views="clr-namespace:MadModStudio.App.Views"
        Title="Mad Mod Studio" Icon="/Assets/MadModStudio.ico" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewModViewModel}"><views:NewModView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepairViewModel}"><views:RepairView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MyModsViewModel}"><views:MyModsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchScannerViewModel}"><views:BatchScannerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameProfilesViewModel}"><views:GameProfilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AIModelsViewModel}"><views:AIModelsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectViewModel}"><views:ProjectView /></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,22">
                    <TextBlock Text="MAD MOD" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="STUDIO" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="1,-2,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Nav" Style="{StaticResource NavRadio}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         CommandParameter="{Binding Key}"
                                         Tag="{Binding Key}" Loaded="NavItem_Loaded">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Column="1" Grid.Row="0" Content="{Binding CurrentPage}" />

        <!-- Status bar -->
        <Border Grid.ColumnSpan="2" Grid.Row="1" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding ProfileStatus}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,24,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding AiStatus}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding DefaultModel}" Width="300" Height="24" Padding="6,2"
                          VerticalAlignment="Center" ToolTip="Global default model. AUTO lets the Auto Model Router pick per agent and task. Projects and individual agents can override this." />
                <TextBlock DockPanel.Dock="Right" Text="Default model" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
