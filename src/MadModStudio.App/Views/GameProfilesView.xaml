<UserControl x:Class="MadModStudio.App.Views.GameProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MadModStudio.App.Views">
    <Grid Margin="32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Game Profiles" Style="{StaticResource H1}" />
                <Button Content="Add 7 Days to Die Installation" Style="{StaticResource AccentButton}" Command="{Binding AddInstallationCommand}" Margin="0,0,0,8" HorizontalAlignment="Left" />
                <Button Content="Add from ZIP..." Command="{Binding AddInstallationFromZipCommand}" Margin="0,0,0,12" HorizontalAlignment="Left"
                        ToolTip="Extract a ZIP of the game or a dedicated server into Mad Mod Studio's data folder and use it as a profile." />
            </StackPanel>
            <ListBox ItemsSource="{Binding ValidationMessages}" DockPanel.Dock="Bottom" Height="150" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding ValidationMessages.Count, Converter={StaticResource NullToVis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" /></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding IndexStatus}" Foreground="{Binding IndexStatus, Converter={StaticResource StatusBrush}}" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <views:PageStatusBar />
                <StackPanel Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Use as Current" Command="{Binding MakeCurrentCommand}" />
                                    <Button Content="Reindex Game" Style="{StaticResource AccentButton}" Command="{Binding ReindexCommand}" />
                                    <Button Content="Open Folder" Command="{Binding OpenInstallFolderCommand}" />
                                    <Button Content="Remove" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H2}" Margin="0" />
                            </DockPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Game name" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.GameName}" Margin="0,6,0,2" />
                                <TextBlock Grid.Row="1" Text="Game version" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,2" TextWrapping="Wrap">
                                    <Run Text="{Binding Selected.GameVersion, Mode=OneWay, TargetNullValue='unknown'}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Selected.GameVersionSource, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" FontSize="11" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="Unity version" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.UnityVersion, TargetNullValue='unknown'}" Margin="0,6,0,2" />
                                <TextBlock Grid.Row="3" Text="Install path" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.InstallPath}" Style="{StaticResource Mono}" Margin="0,6,0,2" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Text="Mods path" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.ModsPath}" Style="{StaticResource Mono}" Margin="0,6,0,2" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Text="Managed assemblies" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.ManagedPath}" Style="{StaticResource Mono}" Margin="0,6,0,2" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="6" Text="Config XML" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Selected.ConfigPath}" Style="{StaticResource Mono}" Margin="0,6,0,2" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="7" Text="Harmony" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Selected.HarmonyAssemblyPath, TargetNullValue='not found'}" Style="{StaticResource Mono}" Margin="0,6,0,2" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="8" Text="Last indexed" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Selected.LastIndexedUtc, Converter={StaticResource LocalTime}}" Margin="0,6,0,2" />
                                <TextBlock Grid.Row="9" Text="Index status" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,6,0,2" TextWrapping="Wrap">
                                    <Run Text="{Binding Selected.IndexStatus, Mode=OneWay}" Foreground="{Binding Selected.IndexStatus, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Selected.IndexError, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Row="10" Text="Index contents" Style="{StaticResource Label}" />
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding IndexSummary}" Style="{StaticResource Dim}" Margin="0,6,0,2" />
                            </Grid>
                            <StackPanel Margin="0,10,0,0">
                                <ProgressBar Value="{Binding IndexPercent}" Maximum="100" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelIndexCommand}" Padding="8,2" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding IndexProgress}" Style="{StaticResource Dim}" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Search Installed Game" Style="{StaticResource H2}" Margin="0,0,0,6" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0" IsDefault="False" />
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="Search_KeyDown" ToolTip="Type, member, XML entry or localization key — e.g. EntityDrone" />
                            </DockPanel>
                            <TextBox Text="{Binding SearchResults, Mode=OneWay}" Style="{StaticResource ReadOnlyMono}" Height="280" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Mod DLL Compilation" Style="{StaticResource H2}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Dim}" Text="Mod DLLs are compiled against this installation's own Managed assemblies (never redistributed copies). The runtime used by Mad Mod Studio is independent of this target." />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                <Run Text="Detected target runtime:" Foreground="{StaticResource TextDimBrush}" />
                                <Run Text="{Binding Selected.Compilation.DetectedTargetRuntime, Mode=OneWay}" />
                            </TextBlock>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="C# language version" Style="{StaticResource Label}" />
                                <TextBox Grid.Column="1" Text="{Binding LanguageVersion}" Width="100" HorizontalAlignment="Left" Margin="0,4" />
                                <TextBlock Grid.Row="1" Text="Extra references (one per line)" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ExtraReferences}" Style="{StaticResource MultiLineBox}" Height="60" Margin="0,4" />
                                <TextBlock Grid.Row="2" Text="Excluded game DLLs (file names)" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExcludedReferences}" Style="{StaticResource MultiLineBox}" Height="60" Margin="0,4" />
                            </Grid>
                            <Button Content="Save Compiler Settings" Command="{Binding SaveCompilerSettingsCommand}" HorizontalAlignment="Left" Margin="170,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
