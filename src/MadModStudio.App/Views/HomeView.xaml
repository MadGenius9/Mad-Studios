<UserControl x:Class="MadModStudio.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MadModStudio.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32" MaxWidth="1100">
            <views:PageStatusBar />
            <TextBlock Text="What do you want to make?" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,14" />
            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Plan with AI  →" Style="{StaticResource AccentButton}" Command="{Binding StartBuildingCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                    <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLineBox}" MinHeight="90" FontSize="15" BorderThickness="0" Background="Transparent"
                             ToolTip="e.g. Create a drone module that sends the drone home to deposit inventory into my Robotic Inbox." />
                </DockPanel>
            </Border>
            <TextBlock Style="{StaticResource Dim}" Text="Example: “Make a placeable block that repairs damaged blocks inside my land claim.” The plan is built from your installed game, not from memory." Margin="2,0,0,18" />

            <WrapPanel Margin="0,0,0,18">
                <Button Content="Import Mod ZIP" Command="{Binding ImportZipCommand}" />
                <Button Content="Import Mod Folder" Command="{Binding ImportFolderCommand}" />
                <Button Content="Repair a Broken Mod" Command="{Binding GoCommand}" CommandParameter="repair" />
                <Button Content="Scan Mods Folder" Command="{Binding GoCommand}" CommandParameter="scanner" />
            </WrapPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Recent Projects" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12,8">
                                    <DockPanel Width="560">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status, Converter={StaticResource StatusText}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                                            <Run Text="·" Foreground="{StaticResource TextDimBrush}" />
                                            <Run Text="{Binding ModType, Mode=OneWay, Converter={StaticResource StatusText}}" Foreground="{StaticResource TextDimBrush}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Recent Repairs" Style="{StaticResource H2}" Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding RecentRepairs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,0,6" Padding="12,8" HorizontalContentAlignment="Left">
                                    <TextBlock>
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}" />
                                        <Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource StatusText}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Current Game Profile" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <StackPanel Visibility="{Binding State.CurrentProfile, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding State.CurrentProfile.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding State.CurrentProfile.GameVersion, TargetNullValue='version unknown'}" Style="{StaticResource Dim}" />
                            <TextBlock Text="{Binding State.CurrentProfile.InstallPath}" Style="{StaticResource Dim}" FontSize="11" Margin="0,4,0,4" />
                            <TextBlock Foreground="{Binding State.CurrentProfile.IndexStatus, Converter={StaticResource StatusBrush}}">
                                <Run Text="Index:" /> <Run Text="{Binding State.CurrentProfile.IndexStatus, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Visibility="{Binding State.CurrentProfile, Converter={StaticResource InvNullToVis}}">
                            <TextBlock Text="No game installation added yet." Style="{StaticResource Dim}" Margin="0,0,0,8" />
                            <Button Content="Add 7 Days to Die Installation" Style="{StaticResource AccentButton}" Command="{Binding GoCommand}" CommandParameter="profiles" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
