<UserControl x:Class="MadModStudio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MadModStudio.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />
            <views:PageStatusBar />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AI Provider" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Dim}">
                        <Run Text="Provider:" /> <Run Text="{Binding ProviderName, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding KeyStatus}" Margin="0,6,0,6" />
                    <TextBlock Style="{StaticResource Dim}" FontSize="11">
                        <Run Text="Stored with:" /> <Run Text="{Binding SecretStoreDescription, Mode=OneWay}" />
                        <Run Text=". Keys are never written to projects, packages, logs or Git." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding CanStoreKey}">
                        <PasswordBox x:Name="KeyBox" Width="380" Margin="0,0,8,0" />
                        <Button Content="Save Key" Style="{StaticResource AccentButton}" Click="SaveKey_Click" />
                        <Button Content="Remove Key" Command="{Binding RemoveKeyCommand}" />
                    </StackPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Model" Style="{StaticResource Label}" />
                        <TextBox Grid.Column="1" Text="{Binding Model}" Width="300" HorizontalAlignment="Left" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="Max automatic repair attempts" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxAttempts}" Width="60" HorizontalAlignment="Left" Margin="0,4" />
                        <Button Grid.Row="2" Grid.Column="1" Content="Save AI Settings" Command="{Binding SaveAISettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,10,0,0"
                               Text="Before any AI operation sends project files, logs or diagnostics, Mad Mod Studio shows exactly what may be sent and asks for confirmation." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Data" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Dim}" Text="Projects, revision history, build outputs and the game index cache live in your data folder, separate from the game's Mods folder. Nothing is deployed to the game automatically." />
                    <TextBlock Text="{Binding Paths.Root}" Style="{StaticResource Mono}" Margin="0,8" />
                    <Button Content="Open Data Folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Coming Soon" Style="{StaticResource H2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Dim}" Text="Deploy to Game · OpenAI and Google Gemini providers · custom AI instructions · GitHub sync. These are not available yet." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
