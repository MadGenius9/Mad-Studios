<UserControl x:Class="MadModStudio.App.Views.MyModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MadModStudio.App.Views">
    <DockPanel Margin="32,24">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Import Mod ZIP" Command="{Binding ImportZipCommand}" />
                    <Button Content="Import Mod Folder" Command="{Binding ImportFolderCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="My Mods" Style="{StaticResource H1}" />
            </DockPanel>
            <views:PageStatusBar />
        </StackPanel>
        <DataGrid x:Name="Grid" ItemsSource="{Binding Projects}" MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mod Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                <DataGridTextColumn Header="Type" Binding="{Binding ModType, Converter={StaticResource StatusText}}" Width="110" />
                <DataGridTemplateColumn Header="Build Status" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="90" />
                <DataGridTextColumn Header="Last Modified" Binding="{Binding ModifiedUtc, Converter={StaticResource LocalTime}}" Width="150" />
                <DataGridTemplateColumn Header="" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open" Padding="8,2" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Content="Folder" Padding="8,2" Command="{Binding DataContext.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Content="Delete" Padding="8,2" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
